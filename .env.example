# Sharp Filter V2 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Odds Data APIs ────────────────────────────────────────────────────────────
# The Odds API: https://the-odds-api.com
ODDS_API_KEY=

# SportsDataIO: https://sportsdata.io
SPORTSDATA_API_KEY=

# ── Twilio SMS Alerts (optional) ─────────────────────────────────────────────
# Leave blank to disable SMS alerts (app will stub safely).
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=

# ── Frontend environment ───────────────────────────────────────────────────────
# Leave blank to use mock data in the browser.
# Set to your FastAPI backend URL to connect real backend.
VITE_API_URL=
